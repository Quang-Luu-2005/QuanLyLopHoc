PORT=3000

# MongoDB connection string (Atlas hoặc local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Tắt transactions nếu dùng standalone MongoDB (không có replica set)
# MONGO_TRANSACTIONS_DISABLED=true

APP_TIMEZONE=Asia/Ho_Chi_Minh
INTERNAL_API_KEY=replace_with_a_long_random_secret

PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
PAYOS_API_BASE=https://api-merchant.payos.vn
PAYOS_RETURN_URL=https://yoursite.com/payment/success
PAYOS_CANCEL_URL=https://yoursite.com/payment/cancel

PAYMENT_CODE_PREFIX=GE
PAYMENT_DEADLINE_HOUR=18
